# Plesk Apache custom directives for live.kriptoentuzijasti.io.
# Install the same content as:
# /var/www/vhosts/system/live.kriptoentuzijasti.io/conf/vhost.conf
# /var/www/vhosts/system/live.kriptoentuzijasti.io/conf/vhost_ssl.conf

ProxyPreserveHost On
RedirectMatch 302 "^/$" "/dashboard"

ProxyPass "/health" "http://127.0.0.1:8791/health" connectiontimeout=3 timeout=10 retry=0
ProxyPassReverse "/health" "http://127.0.0.1:8791/health"

ProxyPass "/dashboard" "http://127.0.0.1:8791/dashboard" connectiontimeout=3 timeout=30 retry=0
ProxyPassReverse "/dashboard" "http://127.0.0.1:8791/dashboard"

ProxyPass "/v1/archive/stream" "http://127.0.0.1:8791/v1/archive/stream" connectiontimeout=3 timeout=3600 retry=0 flushpackets=on
ProxyPassReverse "/v1/archive/stream" "http://127.0.0.1:8791/v1/archive/stream"

ProxyPass "/v1/archive" "http://127.0.0.1:8791/v1/archive" connectiontimeout=3 timeout=30 retry=0
ProxyPassReverse "/v1/archive" "http://127.0.0.1:8791/v1/archive"

ProxyPass "/v1/telegram" "http://127.0.0.1:8791/v1/telegram" connectiontimeout=3 timeout=30 retry=0
ProxyPassReverse "/v1/telegram" "http://127.0.0.1:8791/v1/telegram"

ProxyPass "/v1/live" "ws://127.0.0.1:8791/v1/live" connectiontimeout=5 timeout=3600 retry=0
ProxyPassReverse "/v1/live" "ws://127.0.0.1:8791/v1/live"
